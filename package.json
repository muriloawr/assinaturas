{
  "name": "assinaturas",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @assinaturas/api --filter @assinaturas/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:generate": "pnpm --filter @assinaturas/db generate",
    "db:migrate": "pnpm --filter @assinaturas/db migrate",
    "store:add": "pnpm --filter @assinaturas/api store:add"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
