# Postgres (docker compose up -d postgres)
DATABASE_URL=postgres://assinaturas:assinaturas@localhost:5432/assinaturas

# Chave de 32 bytes em base64 para criptografar o client_secret das lojas.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Token que o painel (apps/web) usa para chamar a API interna.
ADMIN_API_TOKEN=troque-por-um-token-longo

# API (apps/api)
API_PORT=3333
API_PUBLIC_URL=http://localhost:3333

# Painel (apps/web)
API_URL=http://localhost:3333

# Acesso ao painel (Basic Auth provisório). Sem senha, o painel fica bloqueado.
PANEL_USER=admin
PANEL_PASSWORD=
